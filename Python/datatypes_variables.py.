
# Demonstration of Data Types and Variables

# Integer
a = 10
print("Integer:", a, type(a))

# Float
b = 10.5
print("Float:", b, type(b))

# String
c = "Python"
print("String:", c, type(c))

# List
d = [10, 20, 30]
print("List:", d, type(d))

# Tuple
e = (10, 20, 30)
print("Tuple:", e, type(e))

# Dictionary
f = {"name": "Sruchika", "age": 20}
print("Dictionary:", f, type(f))

# Type Conversion
x = 10
y = float(x)
z = str(x)

print("Integer to Float:", y)
print("Integer to String:", z)
